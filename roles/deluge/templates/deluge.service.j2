[Unit]
Description=Deluge BitTorrent Client

[Service]
Type=notify
NotifyAccess=all
WorkingDirectory={{ podman_projects_dir | default('/opt/podman') }}/deluge
ExecStart=/usr/bin/podman kube play --replace --service-container=true --no-pod-prefix --network=pasta:--map-host-loopback={{ podman_gw_gateway }} deluge.yaml
ExecStop=/usr/bin/podman kube down deluge.yaml
Restart=on-failure
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=default.target
