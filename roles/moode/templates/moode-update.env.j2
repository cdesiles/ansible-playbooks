# {{ ansible_managed }}
#
# ntfy notifier configuration for the moOde update check.
# Contains an access token: mode 0600, root-only. Sourced by
# {{ moode_update_script_path }}.
NTFY_SERVER="{{ moode_update_notify_server }}"
NTFY_TOPIC="{{ moode_update_notify_topic }}"
{% if moode_update_notify_token is defined and moode_update_notify_token %}
NTFY_TOKEN="{{ moode_update_notify_token }}"
{% else %}
NTFY_TOKEN=""
{% endif %}
