# {{ ansible_managed }}
#
# ntfy notifier configuration for sys-autoupdate. Contains an access token:
# mode 0600, root-only. Sourced by {{ sys_autoupdate_script_path }}.
NTFY_SERVER="{{ sys_autoupdate_ntfy_server }}"
NTFY_TOPIC="{{ sys_autoupdate_ntfy_topic }}"
{% if sys_autoupdate_ntfy_token is defined and sys_autoupdate_ntfy_token %}
NTFY_TOKEN="{{ sys_autoupdate_ntfy_token }}"
{% else %}
NTFY_TOKEN=""
{% endif %}
