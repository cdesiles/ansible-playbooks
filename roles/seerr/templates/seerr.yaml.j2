---
apiVersion: v1
kind: Pod
metadata:
  name: seerr
  labels:
    app: seerr
  annotations:
    # Map the rootless pod user onto the image's `node` UID/GID so it can
    # write the host-owned config directory.
    io.podman.annotations.userns: "keep-id:uid={{ seerr_container_uid }},gid={{ seerr_container_gid }}"
spec:
  containers:
    - name: seerr
      image: {{ seerr_image }}:{{ seerr_version }}
      ports:
        - containerPort: {{ seerr_port }}
          hostPort: {{ seerr_port }}
      env:
        - name: TZ
          value: "{{ seerr_timezone }}"
        - name: LOG_LEVEL
          value: "{{ seerr_log_level }}"
        - name: PORT
          value: "{{ seerr_port }}"
      volumeMounts:
        - name: localtime
          mountPath: /etc/localtime
          readOnly: true
        - name: config
          mountPath: /app/config
      livenessProbe:
        httpGet:
          path: /api/v1/settings/public
          port: {{ seerr_port }}
        initialDelaySeconds: 60
        periodSeconds: 30
        timeoutSeconds: 10
        failureThreshold: 3
      restartPolicy: Never

  volumes:
    - name: localtime
      hostPath:
        path: /etc/localtime
        type: File
    - name: config
      hostPath:
        path: {{ seerr_config_dir }}
        type: Directory
