# {{ ansible_managed }}
# Essential environment variables - loaded before .zshrc for all sessions

# XDG Base Directory
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

{% if zsh_os_darwin | bool %}
# Homebrew. This role owns ~/.zprofile, so initialise brew here to keep it and
# the tools it installs (fzf, eza, …) on PATH for every zsh session.
if [[ -z "${HOMEBREW_PREFIX:-}" && -x {{ zsh_darwin_brew_prefix }}/bin/brew ]]; then
  eval "$({{ zsh_darwin_brew_prefix }}/bin/brew shellenv)"
fi

{% endif %}
# Rust: rustup toolchain shims and `cargo install` binaries.
if [[ -d "{{ zsh_cargo_bin }}" ]]; then
  export PATH="{{ zsh_cargo_bin }}:$PATH"
fi

# Node.js: locally installed project binaries. Relative entry, so it resolves
# against the current directory at lookup time as you move between projects.
# Appended, so a directory's node_modules can never shadow a system command
# (ls, git, sudo), and skipped for root, which would run whatever it finds.
if [[ $EUID -ne 0 ]]; then
  export PATH="$PATH:./node_modules/.bin"
fi

# Enable color support
export CLICOLOR=1
export COLORTERM=truecolor

# Less configuration
export LESS=-R
export LESS_TERMCAP_mb=$'\E[1;31m'
export LESS_TERMCAP_md=$'\E[1;36m'
export LESS_TERMCAP_me=$'\E[0m'
export LESS_TERMCAP_se=$'\E[0m'
export LESS_TERMCAP_so=$'\E[1;44;33m'
export LESS_TERMCAP_ue=$'\E[0m'
export LESS_TERMCAP_us=$'\E[1;32m'

# Editors
export EDITOR=vim
export VISUAL=vim

# Locale
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Claude Code: no background self-updates (manual `claude update` still works)
export DISABLE_AUTOUPDATER=1
